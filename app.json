{
  "expo": {
    "name": "sport-app",
    "slug": "sport-app",
    "scheme": "sport-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "navigationBar": {
        "visible": "sticky-immersive"
      },
      "package": "com.lep0.sportapp"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser $(PRODUCT_NAME) a acceder a votre bibliotheque pour associer un media a un exercice.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f23d5798-7e8a-4a2a-afef-0d7e6cbe30b2"
      }
    }
  }
}
